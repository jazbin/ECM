FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    shell_outerSurface_rotated
    {
        type            fixedValue;
        value           uniform 298.15;
    }
    shell_rotated_to_jellyRoll_rotated_radial
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
    shell_rotated_to_jellyRoll_rotated_bottom
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        thicknessLayers (9.023925e-04);
        kappaLayers     (1);  // R/2 on shell side — total R = R_STAR with R/2 on jellyRoll side
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
    shell_rotated_to_cap_rotated
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
}

