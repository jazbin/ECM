FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

patches
(
    {
        name            shell_rotated_to_jellyRoll_rotated_radial;
        patchInfo
        {
            type        mappedWall;
            sampleMode  nearestPatchFace;
            sampleRegion jellyRoll_rotated;
            samplePatch  jellyRoll_rotated_to_shell_rotated_radial;
        }
        constructFrom   set;
        set             radialContactFaces;
    }

    {
        name            shell_rotated_to_jellyRoll_rotated_bottom;
        patchInfo
        {
            type        mappedWall;
            sampleMode  nearestPatchFace;
            sampleRegion jellyRoll_rotated;
            samplePatch  jellyRoll_rotated_to_shell_rotated_bottom;
        }
        constructFrom   set;
        set             bottomContactFaces;
    }
);

