FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ecmHeatSource
{
    type            ecmHeatSource;
    active          yes;
    libs            ( "libecmFvOptions.so" );

    ecmHeatSourceCoeffs
    {
        selectionMode   all;
        fields          (h);
        qField          ecmQdot;
    }
}

limitTemperature
{
    type            limitTemperature;
    active          yes;
    selectionMode   all;
    min             250.0;
    max             500.0;
}

