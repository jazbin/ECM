FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       tabulatedAnIso;
    thermo          hTabulated;
    equationOfState icoPolynomial;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles          1;
        molWeight       50.0;
    }
    thermodynamics
    {
        Hf              0;
        Sf              0;
        Cp
        (
            (250 835.55)
            (500 1585.55)
        );
    }
    transport
    {
        kappa           constant (1.4 1.4 29);
    }
    equationOfState
    {
        rhoCoeffs<8>    (2660.7 0 0 0 0 0 0 0);
    }
}

coordinateSystem
{
    type            cylindrical;
    origin          (0 0 0);
    axis            (0 0 1);
    direction       (1 0 0);
}

