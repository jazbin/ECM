FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

patches
(
    // Radial contact (side): mapped to shell radial patch
    {
        name            jellyRoll_0_to_shell_0_radial;
        patchInfo
        {
            type        mappedWall;
            sampleMode  nearestPatchFace;
            sampleRegion shell_0;
            samplePatch  shell_0_to_jellyRoll_0_radial;
        }
        constructFrom   set;
        set             radialContactFaces;
    }

    // Bottom flat contact: mapped to shell bottom patch (interface resistance goes here)
    {
        name            jellyRoll_0_to_shell_0_bottom;
        patchInfo
        {
            type        mappedWall;
            sampleMode  nearestPatchFace;
            sampleRegion shell_0;
            samplePatch  shell_0_to_jellyRoll_0_bottom;
        }
        constructFrom   set;
        set             bottomContactFaces;
    }
);

