FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

pointSync false;

patches
(
    {
        name            shell_1_to_jellyRoll_1_radial;
        patchInfo
        {
            type        mappedWall;
            sampleMode  nearestPatchFace;
            sampleRegion jellyRoll_1;
            samplePatch  jellyRoll_1_to_shell_1_radial;
        }
        constructFrom   set;
        set             radialContactFaces;
    }

    {
        name            shell_1_to_jellyRoll_1_bottom;
        patchInfo
        {
            type        mappedWall;
            sampleMode  nearestPatchFace;
            sampleRegion jellyRoll_1;
            samplePatch  jellyRoll_1_to_shell_1_bottom;
        }
        constructFrom   set;
        set             bottomContactFaces;
    }
);

