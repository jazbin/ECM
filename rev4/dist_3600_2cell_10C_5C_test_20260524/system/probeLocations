FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      probeLocations;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            probes;
libs            ( sampling );

writeControl    timeStep;
writeInterval   1;

fields          ( T );

probeLocations
(
    ( 0 0 0.014 )   // T2 — r=0, z=0.014
    ( 0 0 0.028 )   // T3 — r=0, z=0.028
    ( 0 0 0.042 )   // T4 — r=0, z=0.042
    ( 0 0 0.056 )   // T5 — r=0, z=0.056
);

