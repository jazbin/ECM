FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/shell";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    externalWall
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    shell_to_jellyRoll
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    shell_to_cap
    {
        type            calculated;
        value           uniform (0 0 0);
    }
}

