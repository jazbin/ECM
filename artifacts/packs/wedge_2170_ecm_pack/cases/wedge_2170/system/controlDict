FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Thermal/geometric reference: ../../docs/WEDGE_2170_BATTERY_CELL_THERMAL_PROPERTIES_REFERENCE.md

application     chtMultiRegionSolidFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1200;

deltaT          0.05;

writeControl    adjustableRunTime;

writeInterval   100;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

functions
{
    ecmCoupling
    {
        type            ecmCoupler;
        enabled         true;
        libs            ( "libecmCouplingFunctionObjects.so" );
        executeControl  timeStep;
        writeControl    writeTime;
        region          jellyRoll_rotated;
        zone            jellyRoll_rotated;
        T               T;
        qField          ecmQdot;
        outputMode      volumetricHeat;
        couplingMode    lumped;
        lumpedOutput    totalPower;
        totalVolumeScale 1;         // full 360 deg cylinder
        parallelMode    masterGather;
        keyMode         globalCellId;
        relaxation      0.5;
        writeFields     true;
        subIterations   1;
        subIterationResult average;
        lastGoodFile    "ecm/ecm_last_good.bin";
        inFile          "ecm/ecm_in.json";
        outFile         "ecm/ecm_out.json";
        ioMode          persistentPipe;
        command         "python3 ../../python/ecm_coupling_wrapper.py --input ecm/ecm_in.json --output ecm/ecm_out.json --state ecm/ecm_state.json --backend ecm-step --ecm-call-every-n-steps 5 --vt-min-v -100 --pipe-mode --init-from-csv constant/electrical_inputs_from_validation.csv";
        wrapperStateReset false;
        electricalInputsMode csv;
        electricalInputsFile "constant/electrical_inputs_from_validation.csv";
    }

    jellyRollMeanT
    {
        type            volFieldValue;
        libs            ( fieldFunctionObjects );
        region          jellyRoll_rotated;
        operation       volAverage;
        fields          ( T );
        writeFields     false;
        writeControl    writeTime;
    }
}

