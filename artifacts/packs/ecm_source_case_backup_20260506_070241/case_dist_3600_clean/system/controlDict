FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
// Thermal/geometric setup packaged from in/latest/case12 with ECM enabled.

application     chtMultiRegionSolidFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         3600;

deltaT          0.1;

writeControl    adjustableRunTime;

writeInterval   4000;

purgeWrite      1;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

functions
{
    ecmCoupling
    {
        type            ecmCoupler;
        enabled         true;
        libs            ( "libecmCouplingFunctionObjects.so" );
        executeControl  timeStep;
        writeControl    writeTime;
        region          jellyRoll_rotated;
        zone            jellyRoll_rotated;
        T               T;
        qField          ecmQdot;
        outputMode      volumetricHeat;
        couplingMode    elementWise;
        parallelMode    masterGather;
        keyMode         globalCellId;
        relaxation      1.0;
        writeFields     true;
        subIterations   1;
        subIterationResult average;
        lastGoodFile    "ecm/ecm_last_good.bin";
        elementMappingFile "ecm/mapping_table.csv";
        inFile          "ecm/ecm_in.bin";
        outFile         "ecm/ecm_out.bin";
        ioMode          persistentPipe;
        command "ECM_STATE_FILE=ecm/ecm_state.json ECM_USE_REAL_STEP=1 ECM_DISTRIBUTED_ELECTRICAL_MODE=parallelBranches ECM_INTERP_MODE=linear ECM_LOG_EVERY_N_STEPS=10 python3 python/ecm_coupler.py --pipe-binary";
        wrapperStateReset false;
        electricalInputsMode csv;
        electricalInputsFile "constant/electrical_inputs_from_validation.csv";
        electricalInputsTimeColumn time;
        /*      
        electricalInputs
        {
            current_A       5;
        }
        */
    }

    jellyRollMeanT
    {
        type            volFieldValue;
        libs            ( fieldFunctionObjects );
        region          jellyRoll_rotated;
        operation       volAverage;
        fields          ( T );
        writeFields     false;
        writeControl    writeTime;
    }

    probeLocations
    {
        region          jellyRoll_rotated;
        #include "probeLocations"
    }

    probeT1
    {
        region          shell_rotated;
        #include "probeT1"
    }

    probeT6
    {
        region          cap_rotated;
        #include "probeT6"
    }
}

