FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    shell_outerSurface_rotated
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        h               uniform 110;
        Ta              uniform 298.15;
        kappaMethod     solidThermo;
        value           uniform 298.15;
    }
    shell_rotated_to_jellyRoll_rotated_radial
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
    shell_rotated_to_jellyRoll_rotated_bottom
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        thicknessLayers (1.804785e-03);
        kappaLayers     (1);  // Rtherm_jroll_base = 5.40067678 K/W using the cell base area
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
    shell_rotated_to_cap_rotated
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
}

