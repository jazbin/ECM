FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298.15;

boundaryField
{
    capOuterSurface_rotated
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        h               uniform 110;
        Ta              uniform 298.15;
        kappaMethod     solidThermo;
        value           uniform 298.15;
    }
    cap_rotated_to_jellyRoll_rotated
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
    cap_rotated_to_shell_rotated
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        qrNbr           none;
        qr              none;
        value           uniform 298.15;
    }
}

