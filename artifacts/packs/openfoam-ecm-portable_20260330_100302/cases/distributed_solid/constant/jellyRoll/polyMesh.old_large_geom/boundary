FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/jellyRoll/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

2
(
    jellyRoll_to_cap
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          1528;
        startFace       79220;
        sampleMode      nearestPatchFace;
        sampleRegion    cap;
        samplePatch     cap_to_jellyRoll;
    }
    jellyRoll_to_shell
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          9976;
        startFace       80748;
        sampleMode      nearestPatchFace;
        sampleRegion    shell;
        samplePatch     shell_to_jellyRoll;
    }
)

