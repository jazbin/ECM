FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/jellyRoll";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 313.15;

boundaryField
{
    jellyRoll_to_shell
    {
        type            compressible::ecmTemperatureRadCoupledMixed;
        value           uniform 313.15;
        Tnbr            T;
        qrNbr           none;
        qr              none;
        useImplicit     true;
        useDeltaH       false;
        kappaMethod     solidThermo;
    }
    jellyRoll_to_cap
    {
        type            compressible::ecmTemperatureRadCoupledMixed;
        value           uniform 313.15;
        Tnbr            T;
        qrNbr           none;
        qr              none;
        useImplicit     true;
        useDeltaH       false;
        kappaMethod     solidThermo;
    }
}

