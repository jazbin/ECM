FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/ambient";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

passiveAmbient
{
    // chtMultiRegion* solves the energy field (h/he) and derives T from thermo.
    // Use the built-in constraint that converts the desired temperature to the
    // corresponding energy value via thermo.he(p,T).
    type            fixedTemperatureConstraint;
    active          yes;

    selectionMode   all;

    mode            uniform;
    temperature     constant 313.15;
}

