FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      volFieldValue;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

volFieldValue
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");
    regionType      all;
    operation       volAverage;
    fields          (T);
    writeFields     false;
}

