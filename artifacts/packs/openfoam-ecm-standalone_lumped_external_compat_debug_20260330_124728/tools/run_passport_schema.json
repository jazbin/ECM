{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run_passport",
  "type": "object",
  "required": [
    "metadata",
    "config",
    "metrics",
    "pass"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "case_name",
        "case_path",
        "timestamp_utc",
        "git_sha",
        "openfoam_version",
        "solver",
        "host",
        "n_procs"
      ]
    },
    "config": {
      "type": "object",
      "required": [
        "time_step",
        "write_interval",
        "thresholds"
      ]
    },
    "metrics": {
      "type": "object"
    },
    "pass": {
      "type": "boolean"
    }
  }
}
