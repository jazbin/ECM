FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     chtMultiRegionSolidFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         30;

deltaT          0.1;

adjustTimeStep  no;

writeControl    timeStep;

writeInterval   1;

purgeWrite      5;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

libs            ( "libecmPatchFields.so" );

functions
{
    ecmCoupling
    {
        type            ecmCoupler;
        libs            ( "libecmCouplingFunctionObjects.so" );
        executeControl  timeStep;
        writeControl    timeStep;
        region          jellyRoll;
        zone            jellyRoll;
        T               T;
        qField          ecmQdot;
        stField         ecmST;
        outputMode      volumetricHeat;
        couplingMode    elementWise;
        parallelMode    masterGather;
        keyMode         globalCellId;
        relaxation      0.5;
        writeFields     true;
        inFile          "ecm/ecm_in.bin";
        outFile         "ecm/ecm_out.bin";
        command         "ECM_IN=ecm/ecm_in.bin ECM_OUT=ecm/ecm_out.bin ECM_MAPPING_FILE=ecm/mapping_table_axial6_radial3.csv ECM_STATE_FILE=ecm/ecm_state.json python3 ../../ecm/ecm_coupler.py";
        electricalInputs
        {
            current_A       79;
            SOC             0.5;
            T_min_K         273.15;
            T_max_K         373.15;
            qVolMax         5e4;
        }
    }
}


