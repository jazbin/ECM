FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          controlDict;
}

application     chtMultiRegionSolidFoam;

libs            ( "libecmPatchFields.so" );

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         300;

deltaT          1;

maxCo           1;

maxDi           50;

adjustTimeStep  yes;

writeControl    runTime;

writeInterval   30;

purgeWrite      5;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   8;

runTimeModifiable true;

functions
{
    ecmCoupling
    {
        type            ecmCoupler;
        libs            ( "libecmCouplingFunctionObjects.so" );
        executeControl  timeStep;
        writeControl    writeTime;
        region          jellyRoll;
        zone            jellyRoll;
        T               T;
        qField          ecmQdot;
        stField         ecmST;
        outputMode      volumetricHeat;
        couplingMode    elementWise;
        parallelMode    masterGather;
        keyMode         globalCellId;
        relaxation      0.5;
        writeFields     false;
        inFile          "ecm/ecm_in.bin";
        outFile         "ecm/ecm_out.bin";
        // NCA 4680 chemistry via ecm_step; ECM_CALL_EVERY_N_STEPS=10 matches
        // lumped_solid --ecm-call-every-n-steps 10 subcycling.
        // NOTE: ioMode=binary is mandatory for couplingMode=elementWise (C++ constraint).
        command         "ECM_IN=ecm/ecm_in.bin ECM_OUT=ecm/ecm_out.bin ECM_MAPPING_FILE=ecm/mapping_table_axial6_radial3.csv ECM_STATE_FILE=ecm/ecm_state.json ECM_USE_REAL_STEP=1 ECM_CALL_EVERY_N_STEPS=10 python3 ../../ecm/ecm_coupler.py";
        electricalInputs
        {
            current_A       79;
            SOC             0.5;
            T_min_K         273.15;
            T_max_K         373.15;
        }
    }
    interfaceT_jellyRoll_to_shell
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          jellyRoll;
        regionType      patch;
        name            jellyRoll_to_shell;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    writeTime;
    }
    interfaceT_shell_to_jellyRoll
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          shell;
        regionType      patch;
        name            shell_to_jellyRoll;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    writeTime;
    }
    interfaceT_jellyRoll_to_cap
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          jellyRoll;
        regionType      patch;
        name            jellyRoll_to_cap;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    writeTime;
    }
    interfaceT_cap_to_jellyRoll
    {
        type            surfaceFieldValue;
        libs            ( fieldFunctionObjects );
        region          cap;
        regionType      patch;
        name            cap_to_jellyRoll;
        operation       areaAverage;
        fields          ( T );
        writeFields     false;
        writeControl    writeTime;
    }
}


